#!/bin/bash
source ~/.dotfiles/shell/colors.sh
source ~/.dotfiles/shell/functions.sh

heading "Upgrading brew & brew packages..."
brew update
brew upgrade

heading "Upgrading brew casks..."
brew upgrade --cask
brew cu --all

heading "Upgrading npm global packages..."
npm update -g

heading "Upgrading asdf plugins..."
asdf plugin update --all

heading "Cleaning up..."
brew cleanup

if ask "Update OS?"; then
  sudo softwareupdate -i -a
fi

echo "✅"
