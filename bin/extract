#!/bin/bash
# USAGE: extract FILE...
#
# Extracts archives into the current directory, picking the tool by extension.
# Single-file compressions (.gz, .xz, ...) keep the original file.

if [ $# -lt 1 ]; then
  echo "Usage: $(basename "$0") FILE..." >&2
  exit 1
fi

status=0
for file in "$@"; do
  if [ ! -f "$file" ]; then
    echo "'$file' is not a file." >&2
    status=1
    continue
  fi

  case $file in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst) tar xf "$file" ;;
    *.zip)     unzip -q "$file" ;;
    *.gz)      gunzip -k "$file" ;;
    *.bz2)     bunzip2 -k "$file" ;;
    *.xz)      unxz -k "$file" ;;
    *.zst)     unzstd -q "$file" ;;
    *.7z|*.rar|*.Z) 7zz x "$file" ;;
    *)
      echo "'$file' cannot be extracted." >&2
      status=1
      continue
      ;;
  esac || status=1
done

exit $status
