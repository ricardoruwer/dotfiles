[color]
  branch = auto
  diff = auto
  grep = auto
  interactive = auto
  status = auto
  ui = auto

[alias]
  ap = add --patch
  b = branch
  branches = branch -a
  ci = commit
  cie = commit --allow-empty
  co = checkout
  cp = cherry-pick
  d = diff
  done = !git switch main && git pull && git branch -D @{-1}
  ds = diff --staged
  fix = commit --amend --no-edit
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  lf = log --pretty=format:'%C(yellow)%h %C(blue)%ad%C(red)%d %C(reset)%s%C(green) [%cn]' --decorate --date=short --numstat
  lol = !git add -A && git commit -m \"$(curl --silent --fail https://whatthecommit.com/index.txt)\"
  ma = merge --abort
  mc = merge --continue
  pf = push --force-with-lease
  pom = push origin main
  prune = fetch --prune
  ra = rebase --abort
  rank = shortlog -sn --no-merges
  rc = rebase --continue
  remotes = remote -v
  rim = rebase -i main
  rr = restore
  rrm = rebase main
  s = status -sb
  sp = stash pop
  stash-all = stash save --include-untracked
  sw = switch
  swm = switch main
  tags = tag -l
  ec = commit -m 'Empty commit' --allow-empty
  undo = reset --soft HEAD^
  upd = !git switch main -q && git pull -q && git switch - -q && git rebase main
  updm = !git switch main -q && git pull -q && git switch - -q && git merge main
  wd = diff --color-words
  wip = !git add . && git commit -am 'WIP :construction:'

[core]
  editor = vim
  excludesfile = ~/.gitignore
  pager = delta
  fsmonitor = true
  untrackedCache = true
  whitespace = warn

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  paging = always

[push]
  default = current
  followTags = true
  autoSetupRemote = true

[user]
  email = ricardoruwer@gmail.com
  name = Ricardo Ruwer
  signingkey = 1636C78F4BD437CE

[merge]
  conflictStyle = zdiff3
  ff = false

[help]
  autoCorrect = prompt

[rerere]
  enabled = true

[rebase]
  autoSquash = true
  autoStash = true

[fetch]
  prune = true

[diff]
  algorithm = histogram
  colorMoved = default

[branch]
  sort = -committerdate

[pull]
  rebase = true

[commit]
  gpgsign = true
  verbose = true

[status]
  showUntrackedFiles = all

[url "git@github.com:"]
  insteadOf = https://github.com/

[init]
  defaultBranch = main
[gpg]
  program = gpg
