# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Homebrew prefix is exported by `brew shellenv` (.zprofile)
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# Tab title
DISABLE_AUTO_TITLE="true"

# ZSH Plugins
plugins=(zsh-defer asdf mix fzf gh iterm-tab-color)

# Stamp shown in the history command output.
HIST_STAMPS='dd/mm/yyyy'

# Brew completions (must be on fpath before oh-my-zsh runs compinit)
typeset -U fpath
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)

# User configuration
source $ZSH/oh-my-zsh.sh

# Dotfiles (aliases, functions, exports, etc.)
for file in ~/.dotfiles/shell/*; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Dotfiles autocomplete (written for bash, so it needs bashcompinit)
autoload -Uz bashcompinit && bashcompinit
if [ -f ~/.dotfiles/autocomplete.sh ]; then
  source ~/.dotfiles/autocomplete.sh
fi;
if [ -f ~/.dotfiles/privy/autocomplete.sh ]; then
  source ~/.dotfiles/privy/autocomplete.sh
fi;

# Functions to be executed after every command
onload_function() {
  title "%c"
}

autoload -Uz add-zsh-hook
add-zsh-hook chpwd onload_function
add-zsh-hook precmd onload_function
onload_function

# Itermocil
compctl -g '~/.itermocil/*(:t:r)' itermocil

eval "$(direnv hook zsh)"

# zoxide: `z` and `j` jump to frecent directories, `zi` and `ji` pick one interactively
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
  alias j=z ji=zi
fi

# yazi: `y` opens the file manager and cd's to the last directory on exit
y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Prompt
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
  # Set through RPS1 so zsh-defer doesn't treat the right prompt as unset
  RPS1="$RPROMPT"
fi

# Run after the prompt is shown; falls back to running right away without zsh-defer
_defer() {
  if (( $+functions[zsh-defer] )); then
    zsh-defer "$@"
  else
    "$@"
  fi
}

# fzf-tab: replace the completion menu with fzf
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

# Deferred commands run in the order they are queued: fzf-tab must come before
# the plugins that wrap widgets, and syntax-highlighting goes last
[ -r "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh" ] &&
  _defer source "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh"

# [ -r "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
#   _defer source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Atuin: Ctrl-R opens its history search; Up keeps the default behavior
command -v atuin >/dev/null &&
  _defer eval 'eval "$(atuin init zsh --disable-up-arrow)"'

_defer source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
