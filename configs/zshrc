# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Homebrew prefix is exported by `brew shellenv` (.zprofile)
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# Tab title
DISABLE_AUTO_TITLE="true"

# ZSH Plugins
plugins=(asdf autojump mix fzf gh iterm-tab-color)

# Stamp shown in the history command output.
HIST_STAMPS='dd/mm/yyyy'

# Brew completions (must be on fpath before oh-my-zsh runs compinit)
typeset -U fpath
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)

# User configuration
source $ZSH/oh-my-zsh.sh

# Dotfiles (aliases, functions, exports, etc.)
for file in ~/.dotfiles/shell/*; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;

# Dotfiles autocomplete
if [ -f ~/.dotfiles/autocomplete.sh ]; then
  source ~/.dotfiles/autocomplete.sh
fi;
if [ -f ~/.dotfiles/privy/autocomplete.sh ]; then
  source ~/.dotfiles/privy/autocomplete.sh
fi;

# Functions to be executed after every command
onload_function() {
  title "%c"
}

autoload -Uz add-zsh-hook
add-zsh-hook chpwd onload_function
add-zsh-hook precmd onload_function
onload_function

# Itermocil
compctl -g '~/.itermocil/*(:t:r)' itermocil

eval "$(direnv hook zsh)"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Prompt
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# Must be sourced last
source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
